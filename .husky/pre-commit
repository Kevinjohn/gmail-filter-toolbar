#!/bin/sh

# Ensure pnpm is in PATH and executable (e.g. Windows Git GUI may lack it)
if ! pnpm --version >/dev/null 2>&1; then
  echo "❌  pnpm is required for pre-commit checks"
  echo "   Install the packageManager version declared in package.json and retry"
  exit 1
fi

# Run linting on all files
echo "🔍  Pre-commit: Running ESLint..."
pnpm run lint || exit 1

# Verify formatting (fix with: pnpm run format)
echo "🎨  Pre-commit: Checking Prettier formatting..."
pnpm run format:check || exit 1

# Run unit tests (E2E tests skip automatically in WSL2; run manually when needed: pnpm run e2e)
echo "🧪  Pre-commit: Running unit tests..."
pnpm run test:unit || exit 1

echo "✅  Pre-commit checks passed!"
