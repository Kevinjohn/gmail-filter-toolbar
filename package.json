{
  "name": "gmail-calendar-options",
  "version": "0.2.0",
  "description": "Toggle visibility of calendar invites inside Gmail.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint src --fix",
    "test": "node --experimental-vm-modules --experimental-json-modules node_modules/jest/bin/jest.js",
    "e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=list,junit",
    "audit:options": "node scripts/audit-options.mjs",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\"",
    "validate:env": "node scripts/validate-env.js",
    "test:unit": "node --experimental-vm-modules --experimental-json-modules node_modules/jest/bin/jest.js --runInBand",
    "lint:locales": "node scripts/lint-locales.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.42.1",
    "chrome-launcher": "^1.0.0",
    "eslint": "^8.57.1",
    "globals": "^16.2.0",
    "husky": "^9.0.11",
    "lighthouse": "^12.4.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.0.2",
    "prettier": "^3.6.1",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^3.1.0"
  }
}
