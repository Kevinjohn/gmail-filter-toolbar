        "specifications": {
          "componentName": "loadState",
          "inputs": [],
          "outputs": {
            "returnType": "Promise<void>",
            "description": "Resolves when state is loaded"
          },
          "logic": [
            "Return a new Promise",
            "Call chrome.storage.sync.get to retrieve KEY_MODE and KEY_DEBUG",
