{
  "name": "Gmail Calendar Options",
  "description": "Toggle visibility of calendar invites inside Gmail.",
  "version": "1.0.0",
  "manifest_version": 3,

  /* toolbar icon (shows in chrome://extensions) */
  "action": {
    "default_title": "Calendar filter is embedded on Gmail pages"
  },

  /* event-driven service-worker */
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  /* inject our code on every Gmail tab after the DOM is ready */
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["contentScript.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  /* only need storage API and access to Gmail origin */
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"],

  /* slide-in options pane for debug-mode checkbox */
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  /* pngs live in src/icons/ — all four sizes are required by the Web Store */
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
